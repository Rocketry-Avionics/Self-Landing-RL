# =========================================================================
# Official GitHub Unity Template
# =========================================================================

# Never track temporary/generated build data or large local caches
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures and local profiling logs can contain sensitive data
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools plugins (uncomment if you don't share asset licenses)
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin configs
/[Aa]ssets/Plugins/Editor/JetBrains*

# =========================================================================
# IDE and Solution Files (Regenerated dynamically by Unity)
# =========================================================================
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# =========================================================================
# Content Creation Tools & Asset Cache Extensions
# =========================================================================
# Unity supports Blender asset imports directly, but internal backup files (.blend1) shouldn't be committed.
*.blend1
*.blend1.meta

# =========================================================================
# Operating System Junk Files
# =========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
